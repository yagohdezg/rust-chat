# Database backend: postgres | sqlite
DB_BACKEND=sqlite
DATABASE_URL=sqlite://./.data/rustchat.db
# Postgres example (DB_BACKEND=postgres):
# DATABASE_URL=postgres://rustchat:rustchat@localhost:5432/rustchat

# Apply migrations on boot. Set to false in production and run migrations from
# a one-shot Job instead: `chat-server migrate`.
MIGRATE_ON_BOOT=true

# Server
BIND_ADDR=0.0.0.0:3080
# Must be at least 32 chars; weak/placeholder values are rejected at boot.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Refresh-token lifetime in seconds (default 30 days). Refresh tokens rotate on
# every use; a replayed token revokes all of the user's sessions.
REFRESH_TTL_SECONDS=2592000
LOG_LEVEL=info

# CORS: comma-separated origins allowed to call the API cross-origin. Set to `*`
# to allow any origin; leave the default for local dev. An explicitly empty
# value denies all cross-origin requests (correct behind a same-origin proxy).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3080

# Per-IP rate limiting (fixed window, in-memory). Disable in tests if needed.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=60

# Brute-force lockout for local sign-ins: this many consecutive failures lock
# the account for LOGIN_LOCKOUT_SECONDS. A successful sign-in clears the count,
# and an admin can clear a lock early from the user console
# (PATCH /api/admin/users/{id} {"unlock": true}); lock-outs are audited.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Base64-encoded 32-byte key used to encrypt provider API keys at rest. Generate
# one with: openssl rand -base64 32
# If unset, a key is derived from JWT_SECRET; set this explicitly in production
# so rotating JWT_SECRET does not strand stored keys.
SECRET_ENCRYPTION_KEY=

# Chat providers are configured at runtime (first-run setup page /
# GET /api/providers).

# File uploads
# Where uploaded files live: local | s3. Use `s3` when running more than one
# replica, so every pod can read every upload.
FILE_STORAGE_KIND=local
FILE_STORAGE_DIR=./.data/files
# S3 settings (when FILE_STORAGE_KIND=s3). Credentials come from the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables or an instance profile.
S3_BUCKET=
S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000   # MinIO / Cloudflare R2, if not AWS
# S3_PREFIX=rustchat/                 # optional key namespace inside the bucket

# File library limits for sandbox outputs. An output larger than
# FILE_OUTPUT_MAX_BYTES is rejected and reported to the caller instead of being
# saved. FILE_OUTPUT_ALLOWED_TYPES is an optional allow-list matched against the
# sniffed MIME type or extension: entries may be a MIME (`image/png`), a
# wildcard (`image/*`) or a bare extension (`png`). Empty allows every type.
FILE_OUTPUT_MAX_BYTES=8388608
# FILE_OUTPUT_ALLOWED_TYPES=image/png,image/jpeg,text/plain,pdf

# Upload hardening. UPLOAD_MAX_BYTES caps a single upload; the type is sniffed
# from the bytes (the client's MIME is never trusted) and the filename is
# sanitized. UPLOAD_SCAN_COMMAND optionally names an external scanner (e.g.
# `clamdscan --no-summary --stdout -`) that receives the file on stdin and
# accepts it with exit 0; a non-zero exit rejects the upload.
UPLOAD_MAX_BYTES=26214400
# UPLOAD_SCAN_COMMAND=clamdscan --no-summary --stdout -

# OCR of documents that carry no text layer (scans, screenshots, image-only
# PDFs). OCR_COMMAND names an external recognizer: the document path is appended
# to it as the last argument and its name is in OCR_FILENAME, and the recognized
# text is read from stdout. Point it at a wrapper script, e.g.
#   OCR_COMMAND=/usr/local/bin/ocr.sh
# with `tesseract "$1" stdout` for images and a `pdftoppm | tesseract` pipeline
# for PDFs. Unset: such documents are skipped.
# OCR_COMMAND=/usr/local/bin/ocr.sh

# Account emails (email verification, password reset). MAIL_SEND_COMMAND names a
# sendmail-compatible command that reads an RFC 822 message on stdin (`msmtp -t`,
# `sendmail -t`). With no command configured nothing is delivered and a warning
# is logged, so the flows still run: only the links are not sent.
# PUBLIC_URL is the web app's base URL; links are built from it.
PUBLIC_URL=http://localhost:5173
# MAIL_SEND_COMMAND=msmtp -t
MAIL_FROM=rust-chat <no-reply@localhost>
# Require a confirmed address before an account may use the API. Off by default
# so a fresh instance works without a mail setup; enable it in production.
REQUIRE_EMAIL_VERIFICATION=false
# Token lifetimes in seconds (verification 24h, reset 1h).
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Sandbox. chat-server always executes through the standalone `sandboxd`
# service (BoxLite by default); it holds no in-process backend. `sandboxd` owns
# the sandbox spec and requires SANDBOXD_TOKEN (see services/sandboxd env:
# SANDBOX_BACKEND (`boxlite` or `gvisor`), SANDBOX_IMAGE,
# SANDBOX_TIMEOUT_SECONDS, SANDBOX_MEMORY_MB, SANDBOX_CPUS, SANDBOX_DISK_GB,
# BOXLITE_URL, optional BOXLITE_TOKEN; `gvisor` also reads GVISOR_IMAGE_ROOT).
# Egress is denied unless SANDBOX_NETWORK
# is on; SANDBOX_EGRESS_ALLOW (comma-separated IPv4/CIDR/hostname/`*.wildcard`)
# restricts it to an allow-list.
SANDBOXD_URL=http://localhost:3081
SANDBOXD_TOKEN=

# Agent runtime. Expose the sandbox as the `execute_code` tool to the model
# (off by default: grants model-driven code execution). When COMPUTERS_ENABLED is
# on, `execute_code` runs on the caller's own persistent computer instead of a
# shared ephemeral box; agents opt in via sandbox_enabled (or listing
# execute_code), so those work even with this flag off.
SANDBOX_TOOL_ENABLED=false
# Maximum tool iterations the agent loop may run per chat turn.
AGENT_MAX_ITERATIONS=6

# Provider calls (§3). Rate limits, server errors and transport failures are
# retried this many times (0 disables retrying) with an exponential backoff that
# starts at PROVIDER_RETRY_BASE_MS and is capped at PROVIDER_RETRY_MAX_MS. A
# `Retry-After` header from the provider is honored as sent.
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=250
PROVIDER_RETRY_MAX_MS=8000
# Optional failover: name of a global provider that a request refused by the
# selected provider is replayed against, and the model that replay asks for
# (unset keeps the requested model). The failover provider is skipped when it is
# missing or is the selected provider itself.
PROVIDER_FAILOVER_PROVIDER=
PROVIDER_FAILOVER_MODEL=

# Model allow-list (§3). Deployment-wide cap on which models may be requested;
# comma-separated, empty means no cap. A provider's own allow-list (set via the
# provider API/UI) and an account's allow-list (set by an admin) narrow it
# further, and the model a chat turn asks for must be in the result.
MODEL_ALLOWLIST=

# MCP servers (§2). Expose each user's enabled MCP servers' tools to the agent
# runtime (off by default: a stdio server is an arbitrary executable spawned on
# the host). Servers are configured per user via POST /api/mcp-servers. A stdio
# server can set `sandbox: true` to run inside the sandbox instead of the host,
# which needs `sandboxd` reachable (SANDBOXD_URL/SANDBOXD_TOKEN above).
MCP_ENABLED=false
# A connected MCP server idle for this long is shut down (its process killed)
# and reconnected on demand.
MCP_IDLE_TTL_SECONDS=300

# Per-user persistent "computer" (§4b). One long-lived box per user that
# survives chat sessions; executions route to the node from the placement
# registry. Requires sandboxd/BoxLite nodes. Off by default.
COMPUTERS_ENABLED=false
# Nodes computers may be placed on: `name=url[,name=url...]`. Unset => a single
# `default` node at SANDBOXD_URL.
# SANDBOX_NODES=node-a=http://sandboxd-a:3081,node-b=http://sandboxd-b:3081
# A running/paused computer untouched for this long is destroyed.
COMPUTER_IDLE_TTL_SECONDS=1800
# How often the idle reaper (and warm-pool refill) runs.
COMPUTER_REAP_INTERVAL_SECONDS=60
# Blank boxes kept warm per node to hide cold start (0 disables). Ownership is
# durable: the pool is recorded in the store and reconciled against each node
# every tick, so boxes orphaned by a crash are reclaimed. Ignored when
# COMPUTER_WORKSPACE is on: warm boxes are blank, so a per-user workspace cannot
# mount into one (the reconciler still reclaims leaked boxes).
COMPUTER_WARM_POOL=0
# Mount a durable per-user workspace volume so a computer's files survive its
# box being stopped, snapshotted, reaped or re-provisioned (default on).
COMPUTER_WORKSPACE=true
