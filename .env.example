# Database backend: postgres | sqlite
# PostgreSQL uses pgvector for RAG; SQLite uses a brute-force cosine store.
DB_BACKEND=postgres
DATABASE_URL=postgres://rustchat:rustchat@localhost:5432/rustchat
# SQLite example (DB_BACKEND=sqlite):
# DATABASE_URL=sqlite://./.data/rustchat.db

# Apply migrations on boot. Set to false in production and run migrations from
# a one-shot Job instead: `chat-server migrate`.
MIGRATE_ON_BOOT=true

# Server
BIND_ADDR=0.0.0.0:3080
# Must be at least 32 chars; weak/placeholder values are rejected at boot.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Refresh-token lifetime in seconds (default 30 days). Refresh tokens rotate on
# every use; a replayed token revokes all of the user's sessions.
REFRESH_TTL_SECONDS=2592000
LOG_LEVEL=info

# CORS: comma-separated origins allowed to call the API cross-origin. Set to `*`
# to allow any origin; leave the default for local dev. An explicitly empty
# value denies all cross-origin requests (correct behind a same-origin proxy).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3080

# Per-IP rate limiting (fixed window, in-memory). Disable in tests if needed.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=60

# Base64-encoded 32-byte key used to encrypt provider API keys at rest. Generate
# one with: openssl rand -base64 32
# If unset, a key is derived from JWT_SECRET; set this explicitly in production
# so rotating JWT_SECRET does not strand stored keys.
SECRET_ENCRYPTION_KEY=

# Chat model providers are configured at runtime (first-run setup page /
# GET /api/providers), not from the environment. The first registered user
# becomes an admin and can add an instance-wide provider.
#
# The variables below are only used for RAG embeddings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# RAG / file uploads
# Where uploaded files live: local | s3. Use `s3` when running more than one
# replica, so every pod can read every upload.
FILE_STORAGE_KIND=local
FILE_STORAGE_DIR=./.data/files
# S3 settings (when FILE_STORAGE_KIND=s3). Credentials come from the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables or an instance profile.
S3_BUCKET=
S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000   # MinIO / Cloudflare R2, if not AWS
# S3_PREFIX=rustchat/                 # optional key namespace inside the bucket

EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200

# Sandbox: podman (dev/fallback) | boxlite (production microVM)
SANDBOX_BACKEND=podman
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
# BoxLite REST endpoint when SANDBOX_BACKEND=boxlite (boxlite serve)
BOXLITE_URL=http://localhost:8100

# Agent runtime. Expose the sandbox as the `execute_code` tool to the model
# (off by default: grants model-driven code execution).
SANDBOX_TOOL_ENABLED=false
# Maximum tool iterations the agent loop may run per chat turn.
AGENT_MAX_ITERATIONS=6
