# Copy to deploy/.env and edit. Consumed by deploy/compose.yaml.
#   cp deploy/.env.example deploy/.env

# --- server ---
# Required, >= 32 chars; weak/placeholder values are rejected at boot.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Refresh-token lifetime in seconds (default 30 days).
REFRESH_TTL_SECONDS=2592000
LOG_LEVEL=info

# CORS: origins the browser may call the API from. `*` allows any; an empty
# value denies cross-origin. Defaults to localhost dev ports when unset.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Per-IP rate limiting on /api/auth/* and /api/chat.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=60

# Base64-encoded 32-byte key for encrypting provider API keys at rest.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# --- LLM provider / RAG embeddings ---
# Leave OPENAI_API_KEY empty to disable both chat completions and RAG.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- frontend ---
# URL the browser uses to reach the API (baked into the web bundle).
VITE_API_BASE=http://localhost:3080
WEB_ORIGIN=http://localhost:5173

# --- sandbox ---
# chat-server sends execution to the standalone sandboxd service. The token is
# shared with sandboxd (mandatory there). With `--profile sandboxd`, compose
# also starts the privileged `boxlite` container.
SANDBOXD_URL=http://sandboxd:3081
SANDBOXD_TOKEN=
# BoxLite endpoint for sandboxd: the `boxlite` compose service, or an external
# `boxlite serve` (e.g. http://host.docker.internal:8100). Local `boxlite
# serve` is unauthenticated, so leave BOXLITE_TOKEN empty unless you front it.
BOXLITE_URL=http://boxlite:8100
BOXLITE_TOKEN=
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1

# --- per-user computers (§4b) ---
# Persistent per-user boxes (survive chat sessions). Off by default. Nodes are
# `name=url` pairs; unset => a single `default` node at SANDBOXD_URL.
COMPUTERS_ENABLED=false
# SANDBOX_NODES=node-a=http://sandboxd:3081
COMPUTER_IDLE_TTL_SECONDS=1800
COMPUTER_REAP_INTERVAL_SECONDS=60
COMPUTER_WARM_POOL=0
