# Copy to deploy/.env and edit. Consumed by deploy/compose.yaml.
#   cp deploy/.env.example deploy/.env

# --- server ---
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=3600
LOG_LEVEL=info

# --- LLM provider / RAG embeddings ---
# Leave OPENAI_API_KEY empty to disable both chat completions and RAG.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- frontend ---
# URL the browser uses to reach the API (baked into the web bundle).
VITE_API_BASE=http://localhost:3080
WEB_ORIGIN=http://localhost:5173

# --- sandbox (host-level; not functional inside these containers) ---
SANDBOX_BACKEND=podman
BOXLITE_URL=http://host.docker.internal:8100
SANDBOX_IMAGE=python:3.12-slim
