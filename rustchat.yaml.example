# rustchat.yaml — optional declarative deployment config.
#
# Copy to /etc/rustchat/rustchat.yaml (or set RUSTCHAT_CONFIG) and edit. The file
# is a read-only base layer: environment variables and runtime/DB state override
# it. A missing file is fine. Since it is meant to be baked into an image or
# mounted from a ConfigMap, it is multi-replica safe — never put secrets here.
# Provider API keys still resolve from the DB/env via SECRET_ENCRYPTION_KEY.
#
# Values may reference the environment with ${VAR} or ${VAR:-default}; an unset
# variable without a default fails boot. Unknown keys are rejected at boot.

# Global providers and the models they advertise. These are the admin/global
# providers every user inherits (personal providers are still created via the
# API). `kind` is `openai`, `anthropic` or `custom`.
providers:
  - name: openai
    kind: openai
    base_url: https://api.openai.com/v1
    models:
      - gpt-4o
      - gpt-4o-mini
  - name: local
    kind: custom
    base_url: ${OLLAMA_BASE_URL:-http://localhost:11434/v1}
    # Omit `models` to discover them at runtime.

# Base provider + model used when the request, agent and the user's own
# providers name none. Must reference a provider declared above, and (when that
# provider lists models) one of its models.
defaults:
  provider: openai
  model: gpt-4o-mini

# Provider + model used to auto-generate conversation titles from the first
# exchange. Omit to disable title generation.
title_model:
  provider: openai
  model: gpt-4o-mini

# The sections below are optional; leave a section out (or comment it out) to
# keep the built-in defaults. Every value here is overridden by its environment
# variable when that is set — see docs/rustchat-config.md for the mapping.

# ---- interface ------------------------------------------------------------
# UI copy and outbound links served to the web app.
# interface:
#   custom_welcome: "Welcome! Ask me anything."
#   privacy_policy: https://example.com/privacy
#   terms_of_service: https://example.com/terms

# ---- registration ---------------------------------------------------------
# Self-service sign-up policy. `allowed_domains` is a list of email domains;
# empty allows any domain.
# registration:
#   enabled: true
#   allowed_domains:
#     - example.com

# ---- rate_limits ----------------------------------------------------------
# Per-IP request limits for the auth and chat routes.
# rate_limits:
#   enabled: true
#   auth_per_minute: 30
#   chat_per_minute: 60

# ---- file -----------------------------------------------------------------
# Upload and sandbox-output size and type limits. `output_allowed_types`
# entries may be a full MIME (`image/png`), a wildcard (`image/*`) or a bare
# extension (`png`); empty allows every type.
# file:
#   max_bytes: 26214400
#   output_max_bytes: 8388608
#   output_allowed_types:
#     - image/png
#     - application/pdf

# ---- speech ---------------------------------------------------------------
# Speech (text-to-speech / speech-to-text) toggle.
# speech:
#   enabled: false
